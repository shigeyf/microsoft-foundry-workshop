# =============================================================================
# .gitignore for Bicep Infrastructure-as-Code projects
#
# References:
#   - https://github.com/Azure/ALZ-Bicep
#   - https://github.com/Azure/azure-quickstart-templates
#   - https://github.com/github/gitignore (VisualStudio.gitignore)
# =============================================================================

# ---------------------------------------------------------------------------
# Bicep specific
# ---------------------------------------------------------------------------

# Bicep module restore lock file
# Comment out this line if you want to pin module versions across the team
bicep.lock.json

# ARM JSON templates generated by `bicep build`
# Source of truth is the .bicep files; generated artifacts should not be committed
*.generated.json

# ---------------------------------------------------------------------------
# Azure deployment
# ---------------------------------------------------------------------------

# Parameter files containing user-specific values
# Provide *.example files as templates; users copy and customize locally
*.bicepparam
!*.bicepparam.example

# Local parameter overrides (may contain secrets)
*.local.json

# Azure CLI / Azure PowerShell profile and credentials
.azure/
azureauth.json

# Azure Web App publish settings (contains plaintext passwords)
*.pubxml
*.publishproj
PublishScripts/

# Azure deployment output
csx/
*.build.csdef

# ---------------------------------------------------------------------------
# Secrets and credentials
# ---------------------------------------------------------------------------

# Environment variable files
.env
.env.*
!.env.example
!.env.template

# Certificates and private keys
*.pfx
*.cer
*.pem
*.key
*.p12

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains (Rider, etc.)
.idea/
*.DotSettings.user

# ---------------------------------------------------------------------------
# OS specific
# ---------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------

# Log files
*.log

# Temporary files
*.tmp
*.temp
tmp/
