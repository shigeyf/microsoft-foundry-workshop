# .gitignore for Terragrunt

# Terragrunt cache (downloaded modules, provider plugins, generated backend.tf)
.terragrunt-cache/
**/.terragrunt-cache/

# Terragrunt debug / provider lock generated outside of source dir
terragrunt-debug.tfvars.json
terragrunt-debug*.json

# Files generated by `terraform plan -generate-config-out=...`
generated.tf
generated.tf.json
