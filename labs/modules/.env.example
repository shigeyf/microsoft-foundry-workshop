# .env.example - Environment variable template common to all modules
# Copy this file to create .env and set each value.

# .env.example - 全モジュール共通の環境変数テンプレート
# このファイルをコピーして .env を作成し、各値を設定してください。

#
# cp .env.example .env
#

# Foundry Project Endpoint
# Connection endpoint URL for the Microsoft Foundry project

# Foundry プロジェクトエンドポイント
# Microsoft Foundry プロジェクトの接続エンドポイント URL

FOUNDRY_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com/api/projects/<your-project-id>

# Azure OpenAI Endpoint
# Endpoint URL for the Azure OpenAI resource

# Azure OpenAI エンドポイント
# Azure OpenAI リソースのエンドポイント URL

AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/

# Azure OpenAI API Key (optional, Managed Identity recommended)
# Not required when authenticating with Managed Identity or Service Principal

# Azure OpenAI API キー (オプション、マネージド ID 推奨)
# マネージド ID または サービスプリンシパルで認証する場合は不要

AZURE_OPENAI_API_KEY=

# Azure Subscription ID
# ID of the Azure subscription where the resources belong

# Azure サブスクリプション ID
# リソースが属する Azure サブスクリプションの ID

AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# Azure Resource Group Name
# Name of the resource group containing the Foundry and OpenAI resources

# Azure リソースグループ名
# Foundry および OpenAI リソースが属するリソースグループ名

AZURE_RESOURCE_GROUP=<your-resource-group>
