# .env.example - Module 00: セットアップ用環境変数テンプレート
# このファイルをコピーして .env を作成し、各値を設定してください。
# cp .env.example .env

# Foundry プロジェクトエンドポイント
# Azure AI Foundry プロジェクトの接続エンドポイント URL
FOUNDRY_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com/api/projects/<your-project-id>

# Azure OpenAI エンドポイント
# Azure OpenAI リソースのエンドポイント URL
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/

# Azure OpenAI API キー (オプション、マネージド ID 推奨)
# マネージド ID または サービスプリンシパルで認証する場合は不要
AZURE_OPENAI_API_KEY=

# Azure サブスクリプション ID
# リソースが属する Azure サブスクリプションの ID
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
