{
  "name": "Microsoft Foundry Workshop",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "privileged": true,

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "os-provided"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "extensions": "account"
    },
    "ghcr.io/azure/azure-dev/azd:latest": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.9",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      // "extensions" for this project are specified in here will be installed in Dev Container.
      "extensions": [
        "bierner.markdown-mermaid",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "GitHub.vscode-github-actions",
        "HashiCorp.HCL",
        "hashicorp.terraform",
        "humao.rest-client",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-azureterraform",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-azure-mcp-server",
        "ms-azuretools.vscode-bicep",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-python.pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-vscode.azurecli",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "tfsec.tfsec",
        // Terragrunt extensions
        "caseycs.vscode-terragrunt-navigator",
        "BahramJoharshamshiri.hcl-lsp"
      ],
      // DevContainer automatically inherits the workspace settings.json.
      "settings": {
        "python.useEnvironmentsExtension": true,
        "python-envs.terminal.autoActivationType": "shellStartup"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/setup-pip-wrapper.sh && uv venv --clear --prompt .venv && uv sync --extra dev && uv run poe setup && terraform version && az bicep upgrade && az version",

  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.azure,target=/home/vscode/.azure,type=bind,consistency=cached"
  ]
}
